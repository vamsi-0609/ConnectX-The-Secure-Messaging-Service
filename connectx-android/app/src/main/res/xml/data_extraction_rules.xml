<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!-- N3.1: see backup_rules.xml, same file, same reasoning, for API 31+
             cloud backup. -->
        <exclude domain="sharedpref" path="connectx_secure_auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- N3.1: also excluded from device-to-device transfer. The Keystore backed
             encryption key is non-exportable, so a transferred copy could never be
             decrypted on the new device either. -->
        <exclude domain="sharedpref" path="connectx_secure_auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>